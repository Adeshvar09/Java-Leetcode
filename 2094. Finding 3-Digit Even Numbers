import java.util.ArrayList;
import java.util.List;

class Solution {
    public int[] findEvenNumbers(int[] digits) {
        // Step 1: Count frequency of each digit in the input array
        int[] freq = new int[10];
        for (int digit : digits) {
            freq[digit]++;
        }

        List<Integer> result = new ArrayList<>();

        // Step 2: Iterate through all valid 3-digit even numbers
        for (int num = 100; num < 1000; num += 2) {
            int d1 = num / 100;       // Hundreds digit
            int d2 = (num / 10) % 10;  // Tens digit
            int d3 = num % 10;         // Units digit

            // Temporary count array for the current number
            int[] currentFreq = new int[10];
            currentFreq[d1]++;
            currentFreq[d2]++;
            currentFreq[d3]++;

            // Step 3: Check if input array has enough of each required digit
            if (currentFreq[d1] <= freq[d1] && 
                currentFreq[d2] <= freq[d2] && 
                currentFreq[d3] <= freq[d3]) {
                result.add(num);
            }
        }

        // Convert List<Integer> to int[]
        int[] ans = new int[result.size()];
        for (int i = 0; i < result.size(); i++) {
            ans[i] = result.get(i);
        }

        return ans;
    }
}
